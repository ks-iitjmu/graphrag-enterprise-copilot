# Copy to .env and fill in. Never commit .env.
SEC_USER_AGENT="Your Name your.email@example.com"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# API security (all optional; see api/security.py)
# API_KEY=choose-a-long-random-key      # if set, /ask and /sources require header X-API-Key
# ASK_RATE_PER_MINUTE=6                 # questions per client per minute
# MAX_BODY_BYTES=10240                  # largest accepted request body
# ALLOWED_ORIGINS=                      # comma-separated origins allowed to call the API from browsers
# TRUST_PROXY=0                         # 1 behind a reverse proxy (Azure), to read X-Forwarded-For
# ENABLE_DOCS=1                         # 0 hides /docs
# BUSY_WAIT_SECONDS=30                  # wait for the model before answering "busy"
